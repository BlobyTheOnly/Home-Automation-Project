  {
    "id": "sr_temp_function",
    "type": "function",
    "z": "sr_flow",
    "name": "Process Temperature",
    "func": "const value = Number(msg.payload);\n\nif (isNaN(value)) {\n    return null;\n}\n\nmsg.payload = Number(value.toFixed(1));\nmsg.topic = \"Temperature\";\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 80,
    "wires": [
